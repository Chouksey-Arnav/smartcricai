{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email reference"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "coach"
      ],
      "description": "Message sender role"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "session_id": {
      "type": "string",
      "description": "Chat session identifier"
    }
  },
  "required": [
    "user_email",
    "role",
    "content"
  ]
}
{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "type": {
      "type": "string",
      "enum": [
        "drill",
        "workout",
        "mental",
        "quiz",
        "schedule",
        "achievement"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has read this"
    },
    "related_id": {
      "type": "string",
      "description": "ID of related entity"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ]
}
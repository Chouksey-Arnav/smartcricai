{
  "name": "Profile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "username": {
      "type": "string",
      "description": "Public username"
    },
    "bio": {
      "type": "string",
      "description": "Short bio"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Profile visibility"
    },
    "cricket_iq_score": {
      "type": "number",
      "default": 0,
      "description": "Calculated cricket IQ"
    },
    "archetype": {
      "type": "string",
      "description": "Player archetype"
    },
    "followers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of follower emails"
    },
    "following": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of following emails"
    },
    "social_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Social achievement badges"
    },
    "chat_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Allow direct messages"
    }
  },
  "required": [
    "user_email",
    "username"
  ]
}
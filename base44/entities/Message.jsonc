{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string",
      "description": "Email of sender"
    },
    "receiver_email": {
      "type": "string",
      "description": "Email of receiver"
    },
    "content": {
      "type": "string",
      "description": "Message text only"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Has receiver read it"
    },
    "reaction": {
      "type": "string",
      "enum": [
        "applause",
        "fire",
        "accuracy",
        "grit",
        "none"
      ],
      "default": "none",
      "description": "Emoji reaction"
    }
  },
  "required": [
    "sender_email",
    "receiver_email",
    "content"
  ]
}